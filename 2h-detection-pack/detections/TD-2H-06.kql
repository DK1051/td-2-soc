// TD-2H-06: MFA change after a reset whose ticket note has no out-of-band verification marker.
// The marker text and operation names match the synthetic generator; real ones are TODO(verify).
// Step 1: admin resets whose ticket note (the first changed property) lacks the callback marker.
let unverified_resets = AuditLogs
    | where OperationName == "Reset password (by admin)"
    | extend TicketNote = tostring(TargetResources[0].modifiedProperties[0].newValue)
    // "contains" ignores upper/lower case; "!" means "does not contain".
    | where TicketNote !contains "verified: callback to number on file"
    | project ResetTime = TimeGenerated,
        UserPrincipalName = tostring(TargetResources[0].userPrincipalName),
        ResetBy = tostring(InitiatedBy.user.userPrincipalName),
        TicketNote, ResetCorrelationId = CorrelationId;
// Step 2: MFA method registrations.
let registrations = AuditLogs
    | where OperationName == "User registered security info"
    | project RegisterTime = TimeGenerated,
        UserPrincipalName = tostring(TargetResources[0].userPrincipalName),
        MfaCorrelationId = CorrelationId;
unverified_resets
// Pair each unverified reset with that user's registrations.
| join kind=inner registrations on UserPrincipalName
// Keep registrations within 24 hours after the reset (24h is a planning value).
| where RegisterTime between (ResetTime .. (ResetTime + 24h))
// Final columns: TimeGenerated is the alert time; the rest is the evidence.
| project TimeGenerated = RegisterTime, UserPrincipalName, ResetBy, ResetTime,
    RegisterTime, TicketNote, ResetCorrelationId, MfaCorrelationId
